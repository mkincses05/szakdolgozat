PORT=3000
# The exact frontend origin (`*` is not allowed, because the login cookie is sent with requests)
CORS_ORIGIN=http://localhost:5173
# Turn time limit in milliseconds (R22)
TURN_TIMEOUT_MS=30000
# Reconnect grace period in milliseconds (R23)
RECONNECT_GRACE_MS=60000

# Database (optional; leave DATABASE_URL empty to run without one). The passwords are the ones in the
# root .env used by docker-compose.yml.
# The backend connects with the restricted application role.
DATABASE_URL=postgres://wildhand_app:change-me-app@localhost:5432/wildhand
# `npm run db:migrate` uses the administrator role.
MIGRATION_DATABASE_URL=postgres://wildhand_admin:change-me-admin@localhost:5432/wildhand
# Integration tests; the database name must end in `_test`, because the tests drop its schema.
TEST_DATABASE_URL=postgres://wildhand_admin:change-me-admin@localhost:5432/wildhand_test
